# Provedor do modelo: mock ou openai_compatible
LLM_PROVIDER=mock

# Usado quando LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Configuracao local da API
# Em servidor com proxy reverso na mesma maquina (Caddy), manter 127.0.0.1:
# quem fala com a internet e o proxy. Use 0.0.0.0 apenas em container.
SOFIA_HOST=127.0.0.1
SOFIA_PORT=8000
# Plataformas gerenciadas injetam PORT. Se SOFIA_PORT nao estiver definida,
# a aplicacao usa PORT automaticamente.

# Onde a aplicacao procura este arquivo.
# Sem SOFIA_ENV_FILE, ela usa o .env da raiz do projeto — nunca do diretorio
# de onde o processo foi iniciado. Em producao, aponte para fora da arvore de
# codigo para que um deploy nao encoste no segredo:
# SOFIA_ENV_FILE=/etc/sofia/sofia.env

# Armazenamento de sessoes: sqlite ou memory
SESSION_STORE=sqlite
# Caminho relativo e resolvido a partir da raiz do projeto. Em producao,
# prefira absoluto e fora da arvore de codigo:
# SQLITE_PATH=/var/lib/sofia/sofia_sessions.db
SQLITE_PATH=data/sofia_sessions.db
EVENT_LOG_ENABLED=true
EVENT_LOG_PATH=data/sofia_events.db

# Apenas para teste local. Nao habilitar em endpoint publico.
DEBUG_ENDPOINTS_ENABLED=false

# Endpoints locais /chat e /reset. Em endpoint publico (webhook exposto),
# desabilite ou proteja por proxy: LOCAL_API_ENABLED=false
LOCAL_API_ENABLED=true

# WhatsApp Business Platform / Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Por seguranca, deixe false ate validar em ambiente de teste.
WHATSAPP_SEND_MESSAGES=false

# Maxbot. Use um segredo URL-safe e configure no painel a URL:
# https://SEU_HOST/webhook/maxbot/SEU_SEGREDO
MAXBOT_API_TOKEN=
MAXBOT_CHANNEL_TOKEN=
MAXBOT_WEBHOOK_SECRET=
# Piloto seguro: o contato precisa estar no segmento OU na lista de telefones.
MAXBOT_PILOT_MODE=true
MAXBOT_PILOT_SEGMENT=SOFIA_API_PILOTO
MAXBOT_PILOT_PHONES=
# Excecao estrita para teste controlado em protocolo automatico do Maxbot.
# Manter false fora de uma janela supervisionada.
MAXBOT_PILOT_ALLOW_ATTENDANCE=false
MAXBOT_SEND_MESSAGES=false
MAXBOT_API_URL=https://app.maxbot.com.br/api/v1.php
# Timeout do envio, em segundos. O envio acontece dentro do handler do
# webhook: um valor alto segura o ACK e convida o Maxbot a reenviar.
MAXBOT_TIMEOUT_SECONDS=10

# Horas ate uma sessao em handoff voltar a ser atendida pela Sofia.
# Sem isso, quem conclui o fluxo fica em silencio permanente ate alguem rodar
# scripts/resetar_sessao.py a mao. 0 desliga e volta ao reset manual.
# O valor definitivo depende do ritmo do Comercial da SS Vale.
HANDOFF_EXPIRA_HORAS=24

# Token do endpoint /status, para acompanhar o piloto sem abrir shell no
# servidor. Vazio desliga a rota. Use um valor proprio, diferente do
# MAXBOT_WEBHOOK_SECRET. O /status devolve apenas contagens, nunca conversa.
# Consulta: curl -H "X-Status-Token: <token>" https://SEU_HOST/status
STATUS_TOKEN=
